    "AGENT_ID": "cp",
    "AGENT_NAME": "GitHub Copilot",
    "AGENT_TITLE": "GitHub Copilot CLI Configuration",
    "ARG_SYNTAX": "$ARGUMENTS",
    "ARG1_SYNTAX": "$1",
    "CMD_PREFIX": "/aigon-",
    "AGENT_TEAMS_RESEARCH_NOTE": "",
    "AGENT_TEAMS_FEATURE_NOTE": "",
    "PERMISSION_SAVE_NOTE": "",
    "AGENT_PITFALLS": "\n## GitHub Copilot CLI Notes\n\n- Model availability depends on the signed-in Copilot plan and organization policy. Use Auto when a named model is unavailable.\n- Aigon launches the interactive TUI with `--allow-all`; do not replace this with `-p` or `--prompt`, because one-shot mode breaks session observability and follow-up input.\n- Transcript, cost, token, and resume integration are not available in this first release.\n",
    "AGENT_DEV_SERVER_NOTE": ""
  },
  "output": {
    "format": "skill-md",
    "commandDir": ".agents/skills",
    "commandFilePrefix": "aigon-",
    "commandFileExtension": "",
    "skillFileName": "SKILL.md",
    "frontmatter": [
      "name",
      "description"
    ],
    "global": false
  },
  "rootFile": null,
  "supportsAgentsMd": true,
  "agentFile": "github-copilot.md",
  "templatePath": "generic/docs/agent.md",
  "extras": {},
  "signals": {
    "shellTrap": true,
    "heartbeatSidecar": true,
    "cliHooks": null
  },
  "legacy": {
    "promptFile": null
  },
  "failureDetectors": {
    "tokenExhaustion": {
      "exitCodes": [
        1,
        2
      ],
      "stderrPatterns": [
        "quota exceeded",
        "usage limit",
        "rate limit exceeded"
      ]
    }
  },
