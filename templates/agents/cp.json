{
  "id": "cp",
  "name": "GitHub Copilot",
  "aliases": [
    "copilot",
    "github-copilot",
    "cp"
  ],
  "displayName": "GitHub Copilot CLI",
  "shortName": "CP",
  "providerFamily": "router",
  "portOffset": 9,
  "terminalColor": "white",
  "bannerColor": "#8250DF",
  "defaultFleetAgent": false,
  "installHint": "brew install copilot-cli  (or: npm i -g @github/copilot)",
  "installCommand": "npm i -g @github/copilot",
  "authCheck": {
    "method": "none",
    "loginCommand": "copilot login",
    "loginHint": "Run copilot login and authenticate with a Copilot-enabled GitHub account"
  },
  "trust": null,
  "worktreeEnv": {},
  "git": {
    "hasEmailAttribution": true
  },
  "capabilities": {
    "supportsModelFlag": true,
    "transcriptTelemetry": false,
    "resolvesSlashCommands": true
  },
  "runtime": {
    "sessionStrategy": null,
    "telemetryStrategy": null,
    "trustInstallScope": "worktree-base",
    "resume": null,
    "continuity": {
      "resumeById": false,
      "taskDelivery": "initial-argument"
    }
  },
  "quota": {
    "errorPatterns": [],
    "successPatterns": [
      "^PONG$",
      "PONG"
    ],
    "unknownPolicy": "permit"
  },
