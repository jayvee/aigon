{
  "aigon": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "aigon check-version --notice-only >/dev/null",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "aigon project-context --json >/dev/null",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "aigon check-agent-signal --json >/dev/null",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "aigon capture-antigravity-telemetry >/dev/null",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "aigon capture-antigravity-telemetry >/dev/null",
        "timeout": 15
      }
    ]
  }
}
